{
  "name": "room-booking",
  "version": "1.0.0",
  "private": true,
  "description": "The system under test: a meeting-room booking API (Node 26, TypeScript run directly, no dependencies).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "test": "node --test \"test/*.test.ts\"",
    "test:junit": "node -e \"require('node:fs').mkdirSync('reports',{recursive:true})\" && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/unit-tests.xml \"test/*.test.ts\""
  },
  "author": "Niranjan Kumar Agri",
  "license": "MIT"
}
